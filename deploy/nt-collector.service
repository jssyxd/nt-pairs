[Unit]
Description=nt-pairs L2 collector (HL / Lighter / OKX, public data only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/nt-pairs
Environment=PYTHONUNBUFFERED=1
# 只采 KIOXIA / RKLB 两对；depth 10 控磁盘；跨天压缩；保留 7 天；
# --min-free-mb 512：磁盘不足时采集器自行停止（exit 2，见 RestartPreventExitStatus）
# 路径口径：以 malaysia(155.254.60.38) 为权威节点，脚本在 scripts/ 下、venv 在 .venv/
EnvironmentFile=/etc/nt-pairs/env
ExecStart=/opt/nt-pairs/.venv/bin/python scripts/collect_l2.py \
  --targets configs/collector_targets.json \
  --interval 5 \
  --workers 24 \
  --compress \
  --keep-days 7 \
  --min-free-mb 512
Restart=always
# 采集器因磁盘不足主动退出（exit 2）时不要立刻重启，否则只是反复撞同一堵墙
RestartPreventExitStatus=2
RestartSec=15
# 采集器吃内存很小，但别让 OOM 影响同机的 ant-arb.service
MemoryMax=400M
CPUQuota=50%
Nice=10
StandardOutput=append:/opt/nt-pairs/state/collector.log
StandardError=append:/opt/nt-pairs/state/collector.log

[Install]
WantedBy=multi-user.target
