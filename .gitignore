.venv/
.venv-nt/
__pycache__/
*.pyc
.pytest_cache/
state/
data/*
# OKX 标的快照要进版本库：build_matrix 依赖它（ant-cross-arb 删除后唯一的来源）
!data/snapshots/
!data/snapshots/*.json
# 座舱与扫描产物同样需要进版本库（报告与复现用）
!data/cockpit/
!data/chd_screen.json
!data/chd_universe.json
*.log
.env
.herd-dispatch/
*.egg-info/
build/
dist/
.tmp/
# 座舱面板是自包含 HTML（内联 plotly.js ≈ 5MB），与 tearsheet 一样只留本地、不进版本库
reports/cockpit/*.html
